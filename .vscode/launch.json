    "version": "0.2.0",
    "configurations": [
        {
            "name": "satchel",
            "cwd": "apps/satchel",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=google_oauth.json"
            ],
            "args": [
                "--web-port",
                "5000",
            ]
        },
        {
            "name": "satchel (profile mode)",
            "cwd": "apps/satchel",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=google_oauth.json"
            ]
        },
        {
            "name": "satchel (release mode)",
            "cwd": "apps/satchel",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=google_oauth.json"
            ]
        },
        {
            "name": "satchel_core",
            "cwd": "packages/satchel_core",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "satchel_storage",
            "cwd": "packages/satchel_storage",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "satchel_storage (profile mode)",
            "cwd": "packages/satchel_storage",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "satchel_storage (release mode)",
            "cwd": "packages/satchel_storage",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}